---
const siteTitle = "Water Damage Restoration Services USA";
const siteDescription =
  "24/7 emergency water damage restoration services across the USA. Fast response for flood, leak, and storm damage cleanup.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body style="margin:0; font-family: Arial, sans-serif;">

    <!-- HERO SECTION -->
    <section style="padding:70px 20px; background:#0f172a; color:white; text-align:center;">
      <h1>Water Damage Restoration Services in the USA</h1>
      <p style="max-width:700px; margin:20px auto;">
        Emergency water damage cleanup for homes and businesses.
        Serving major US cities with fast response and certified restoration experts.
      </p>
      <strong>Call 24/7 for Emergency Service</strong>
    </section>

    <!-- SERVICES -->
    <section style="padding:40px 20px; max-width:900px; margin:auto;">
      <h2>Our Water Damage Services</h2>
      <ul>
        <li>Emergency Water Removal</li>
        <li>Flood Damage Cleanup</li>
        <li>Burst Pipe & Leak Drying</li>
        <li>Mold Prevention & Structural Drying</li>
        <li>Commercial Water Damage Restoration</li>
      </ul>
    </section>

    <!-- PROGRAMMATIC SEO SECTION -->
    <section style="padding:40px 20px; background:#f1f5f9;">
      <h2>Water Damage Restoration Near You</h2>
      <p>
        We provide professional water damage restoration services in
        Dallas, Houston, Austin, Los Angeles, New York, Chicago, and other US cities.
      </p>
      <p>
        Each city page is optimized to help homeowners find fast, local emergency services.
      </p>
    </section>

    <!-- TRUST / SEO CONTENT -->
    <section style="padding:40px 20px; max-width:900px; margin:auto;">
      <h2>Why Choose Our Restoration Team</h2>
      <p>
        Our technicians follow industry standards for water extraction,
        drying, and damage mitigation to protect your property and health.
      </p>
    </section>

    <!-- CONTACT -->
    <section style="padding:40px 20px; background:#0f172a; color:white;">
      <h2>Emergency Contact</h2>
      <p>Email: support@example.com</p>
      <p>Phone: +1-XXX-XXX-XXXX</p>
      <p>Available 24/7 across the USA</p>
    </section>

    <footer style="padding:20px; text-align:center; background:#020617; color:#94a3b8;">
      © 2026 Water Damage Restoration USA
    </footer>

  </body>
</html>
